@model ChatMVC.Models.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    Layout = "_Layout";
}

<div id="app">

    <header id="app-header">
        <div class="header-brand">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span>RealTime Chat</span>
        </div>
        <div id="connection-badge" class="badge badge--disconnected">
            <span class="badge__dot"></span>
            <span id="connection-text">Disconnected</span>
        </div>
    </header>

    <div id="layout">

        <aside id="sidebar">

            <div class="panel" id="panel-setup">
                <p class="panel__title">Connect</p>
                <div class="field">
                    <label for="username-input">Username</label>
                    <input id="username-input" type="text" placeholder="e.g. Alice" maxlength="50" autocomplete="off">
                </div>
                <div class="field">
                    <label for="room-input">Room</label>
                    <input id="room-input" type="text" placeholder="e.g. general" maxlength="50" autocomplete="off">
                </div>
                <button id="join-btn" class="btn btn--primary">Join Room</button>
            </div>

            <div class="panel" id="panel-room" hidden>
                <p class="panel__title">Current Room</p>
                <div id="room-tag" class="room-tag"></div>
                <button id="leave-btn" class="btn btn--ghost">Leave Room</button>
            </div>

            <div class="panel">
                <p class="panel__title">Online Users</p>
                <ul id="users-list">
                    <li class="users-list__empty">No users online</li>
                </ul>
            </div>

        </aside>

        <main id="chat">

            <div id="chat-overlay">
                <div class="overlay-inner">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <p>Enter a username and room<br>to start chatting</p>
                </div>
            </div>

            <div id="messages"></div>

            <div id="input-bar">
                <input id="message-input" type="text" placeholder="Type a message and press Enter…" disabled autocomplete="off">
                <button id="send-btn" disabled aria-label="Send">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </div>

        </main>

    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = '@Model.ApiBaseUrl';
        const HUB_URL = '@Model.HubUrl';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
