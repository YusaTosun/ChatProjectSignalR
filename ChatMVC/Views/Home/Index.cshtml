@model ChatMVC.Models.ChatViewModel
@{
    ViewData["Title"] = "Chat";
    Layout = "_Layout";
}

<div id="app">

    <header id="app-header">
        <div class="header-left">
            <button id="sidebar-toggle" class="sidebar-toggle" aria-label="Menüyü aç">
                <span></span><span></span><span></span>
            </button>
            <div class="header-brand">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <span>RealTime Chat</span>
            </div>
        </div>

        <div class="header-right">
            <div class="header-user">
                <div class="user-avatar user-avatar--sm">@Model.Username.Substring(0, 1).ToUpper()</div>
                <span class="header-username">@Model.Username</span>
            </div>
            <div id="connection-badge" class="badge badge--disconnected">
                <span class="badge__dot"></span>
                <span id="connection-text">Disconnected</span>
            </div>
            <button id="theme-toggle" class="theme-toggle" title="Temayı değiştir" aria-label="Temayı değiştir">
                <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
                </svg>
                <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"/>
                    <line x1="12" y1="1" x2="12" y2="3"/>
                    <line x1="12" y1="21" x2="12" y2="23"/>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
                    <line x1="1" y1="12" x2="3" y2="12"/>
                    <line x1="21" y1="12" x2="23" y2="12"/>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
                </svg>
            </button>
            <a asp-controller="Account" asp-action="Logout" class="btn btn--ghost btn--sm">Logout</a>
        </div>
    </header>

    <div id="layout">

        <div id="sidebar-backdrop"></div>

        <aside id="sidebar">

            <div class="panel" id="panel-setup">
                <p class="panel__title">Create Room</p>
                <div class="field">
                    <label for="room-input">Room Name</label>
                    <input id="room-input" type="text" placeholder="e.g. general" maxlength="50" autocomplete="off">
                </div>
                <button id="join-btn" class="btn btn--primary">Create Room</button>
            </div>

            <div class="panel" id="panel-room" hidden>
                <p class="panel__title">Current Room</p>
                <div id="room-tag" class="room-tag"></div>
                <button id="leave-btn" class="btn btn--ghost">Leave Room</button>
            </div>

            <div class="panel">
                <p class="panel__title">Active Rooms</p>
                <ul id="rooms-list">
                    <li class="list-empty">No active rooms</li>
                </ul>
            </div>

            <div class="panel">
                <p class="panel__title">Online Users</p>
                <ul id="users-list">
                    <li class="list-empty">No users online</li>
                </ul>
            </div>

        </aside>

        <main id="chat">

            <div id="chat-overlay">
                <div class="overlay-inner">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                    <p>Pick a room from the list<br>or enter a name to join</p>
                </div>
            </div>

            <div id="messages"></div>

            <div id="typing-indicator"></div>

            <div id="media-preview" hidden>
                <div id="media-preview-inner"></div>
                <button id="media-remove-btn" title="Kaldır">✕</button>
            </div>

            <div id="input-bar">
                <div id="emoji-picker" hidden>
                    <div class="emoji-picker__search-wrap">
                        <input id="emoji-search" type="text" placeholder="Ara…" autocomplete="off">
                    </div>
                    <div class="emoji-picker__categories" id="emoji-categories"></div>
                    <div class="emoji-picker__grid" id="emoji-grid"></div>
                </div>
                <label id="media-btn" title="Resim / Video ekle">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </svg>
                    <input type="file" id="media-input" accept="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm" hidden>
                </label>
                <button id="emoji-btn" title="Emoji ekle" type="button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M8 13s1.5 2 4 2 4-2 4-2"/>
                        <line x1="9" y1="9" x2="9.01" y2="9"/>
                        <line x1="15" y1="9" x2="15.01" y2="9"/>
                    </svg>
                </button>
                <input id="message-input" type="text" placeholder="Type a message and press Enter…" disabled autocomplete="off">
                <button id="send-btn" disabled aria-label="Send">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="22" y1="2" x2="11" y2="13"/>
                        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
                    </svg>
                </button>
            </div>

        </main>

    </div>
</div>

@section Scripts {
    <script>
        const API_BASE_URL = '@Model.ApiBaseUrl';
        const HUB_URL = '@Model.HubUrl';
        const CURRENT_USER_ID = '@Model.UserId';
        const CURRENT_USERNAME = '@Model.Username';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@@8/dist/browser/signalr.min.js"></script>
    <script src="~/js/chat.js" asp-append-version="true"></script>
}
